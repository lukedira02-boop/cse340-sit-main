<%- include('partials/header') %>

<main id="main-content" class="container">
    <h1><%= title %></h1>
    <p class="lead">These community groups host the projects you can join.</p>
    <p><a class="button" href="/new-organization">Add an Organization</a></p>

    <div class="card-grid">
        <% organizations.forEach((organization) => { %>
            <article class="card">
                <img src="<%= organization.logo ? (/^(https?:)?\/\//i.test(organization.logo) || organization.logo.startsWith('/') ? organization.logo : `/images/${organization.logo}`) : '/images/organization-placeholder.svg' %>" alt="<%= organization.name %>" width="320" height="200">
                <div class="card-body">
                    <h2><a href="/organization/<%= organization.id %>"><%= organization.name %></a></h2>
                    <p><%= organization.description %></p>
                    <p class="contact"><a href="mailto:<%= organization.email %>"><%= organization.email %></a></p>
                </div>
            </article>
        <% }) %>
    </div>
</main>

<%- include('partials/footer') %>
