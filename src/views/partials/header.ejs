<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Service Connect</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/">Service Connect</a>
            <nav aria-label="Main navigation">
                <ul class="nav-list">
                    <li><a href="/">Home</a></li>
                    <li><a href="/organizations">Organizations</a></li>
                    <li><a href="/projects">Projects</a></li>
                    <li><a href="/categories">Categories</a></li>
                    <% if (isLoggedIn) { %>
                        <li><a href="/dashboard">Dashboard</a></li>
                        <% if (currentUser.role_name === 'admin') { %>
                            <li><a href="/users">Users</a></li>
                        <% } %>
                        <li><a href="/logout">Log out</a></li>
                    <% } else { %>
                        <li><a href="/register">Register</a></li>
                        <li><a href="/login">Log in</a></li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </header>
    <% if (messages && (messages.success.length || messages.error.length)) { %>
        <div class="container flash-messages" aria-live="polite">
            <% messages.success.forEach((message) => { %>
                <p class="flash-message flash-success" role="status"><%= message %></p>
            <% }) %>
            <% messages.error.forEach((message) => { %>
                <p class="flash-message flash-error" role="alert"><%= message %></p>
            <% }) %>
        </div>
    <% } %>
