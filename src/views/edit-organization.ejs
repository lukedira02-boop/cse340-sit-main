<%- include('partials/header') %>

<main id="main-content" class="container">
    <p><a href="/organization/<%= organization.id %>">Back to organization</a></p>
    <section class="panel form-panel">
        <h1><%= title %></h1>
        <form action="/edit-organization/<%= organization.id %>" method="POST">
            <div class="form-field">
                <label for="name">Organization name</label>
                <input id="name" name="name" type="text" maxlength="150" value="<%= organization.name %>" required>
            </div>
            <div class="form-field">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500" required><%= organization.description %></textarea>
            </div>
            <div class="form-field">
                <label for="contactEmail">Contact email</label>
                <input id="contactEmail" name="contactEmail" type="email" maxlength="255" value="<%= organization.email %>" required>
            </div>
            <div class="form-field">
                <label for="logoFilename">Logo filename</label>
                <input id="logoFilename" name="logoFilename" type="text" maxlength="255" value="<%= organization.logo %>" required>
            </div>
            <button class="button" type="submit">Update Organization</button>
        </form>
    </section>
</main>

<%- include('partials/footer') %>
