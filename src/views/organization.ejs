<%- include('partials/header') %>

<main id="main-content" class="container">
    <p><a href="/organizations">All organizations</a></p>
    <article class="panel">
        <p><a class="button button-secondary" href="/edit-organization/<%= organization.id %>">Edit Organization</a></p>
        <img class="organization-detail-image" src="<%= organization.logo ? (/^(https?:)?\/\//i.test(organization.logo) || organization.logo.startsWith('/') ? organization.logo : `/images/${organization.logo}`) : '/images/organization-placeholder.svg' %>" alt="<%= organization.name %>" width="640" height="400">
        <h1><%= organization.name %></h1>
        <p><%= organization.description %></p>
        <p><strong>Contact:</strong> <a href="mailto:<%= organization.email %>"><%= organization.email %></a></p>
    </article>

    <section aria-labelledby="organization-projects">
        <h2 id="organization-projects">Service projects</h2>
        <% if (projects.length > 0) { %>
            <ul class="project-list">
                <% projects.forEach((project) => { %>
                    <li class="panel">
                        <h3><a href="/project/<%= project.id %>"><%= project.name %></a></h3>
                        <p><%= project.description %></p>
                        <p><strong>Location:</strong> <%= project.location %></p>
                        <% const schedule = project.schedule instanceof Date ? project.schedule.toISOString().slice(0, 10) : String(project.schedule).slice(0, 10); %>
                        <p><strong>Schedule:</strong> <time datetime="<%= schedule %>"><%= new Date(`${schedule}T00:00:00`).toLocaleDateString('en-US') %></time></p>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>This organization has no service projects yet.</p>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
